#!/bin/sh
# The BEAM node holds the vault keys, the HMAC secret and decrypted values in
# memory (docs/security/crypto-inventory.md, Limits (1)).
# No crash dump file. For a debugging session, set ERL_CRASH_DUMP_BYTES to a
# size limit and ERL_CRASH_DUMP to a path outside the image; the dump then
# holds the keys.
export ERL_CRASH_DUMP_BYTES="${ERL_CRASH_DUMP_BYTES:-0}"
# No Erlang distribution, so `bin/espalier remote` and `bin/espalier rpc`
# cannot attach to the running node. `bin/espalier eval` starts a node of its
# own and keeps working, which the functions in lib/espalier/release.ex rely on.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
# bin/espalier sources this file before it falls back to releases/COOKIE,
# which the image leaves out (Dockerfile): a cookie in the image is known to
# everyone who holds the image. Without distribution, each command gets a
# random cookie that no other node knows. With distribution, the operator
# sets RELEASE_COOKIE to a random secret that the nodes share.
if [ "$RELEASE_DISTRIBUTION" = none ]; then
  if [ -z "${RELEASE_COOKIE:-}" ]; then
    RELEASE_COOKIE=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
  fi
  export RELEASE_COOKIE
elif [ -z "${RELEASE_COOKIE:-}" ]; then
  echo "ERROR: RELEASE_DISTRIBUTION=$RELEASE_DISTRIBUTION needs RELEASE_COOKIE, a random secret that every node of the cluster shares (for example from openssl rand -hex 32)" >&2
  exit 1
fi
