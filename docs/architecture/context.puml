@startuml context
title Espalier: system context and components
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

actor Learner
actor "Author / Admin" as Staff
actor Facilitator
actor "Analyst / Registrar" as Analyst

node "Browser" {
  package "SPA (Vite, React, Tailwind CSS)" {
    [Learner area] as LA
    [Admin area] as AA
    [Player\n(content renderer)] as Player
    interface "Runtime" as RT
    [PlatformRuntime] as PR
  }
}

node "Application server (Elixir release)" {
  package "EspalierWeb (Phoenix)" {
    [SPA controller\n(serves index.html)] as Spa
    [JSON API\n/api] as Api
    [Auth controllers\n/auth] as Auth
    [OpenAPI spec\n/api/openapi] as Spec
    [Media route\n/media/:file] as MediaRoute
  }
  package "Espalier (contexts)" {
    [Accounts\n(sessions, passkeys,\nTOTP, recovery)] as Accounts
    [Identity\n(oidcc, :eldap)] as Idp
    [Vault\n(Cloak, AES-GCM, HMAC)] as Vault
    [Rate limiter\n(Hammer)] as Limiter
    [Catalog] as Catalog
    [Learning] as Learning
    [Credentials] as Credentials
    [Policies] as Policies
    [Insights] as Insights
    [Interop] as Interop
    [Workbench\n(pack drafts)] as Workbench
    [Media\n(library, conversion,\nSVG rebuild, WebVTT check)] as Media
    [Audit] as Audit
    [Repo (Ecto)] as Repo
  }
  [Oban jobs] as Oban
  [ffmpeg / ffprobe\n(separate processes\nunder timeout)] as Ffmpeg
}

folder "Media store\n(MEDIA_DIR: files, incoming,\nwork, uploads)" as Store
[clamd\n(optional, ClamAV)] as Clamd
cloud "Allowlisted media hosts" {
  [External video files\n(MEDIA_EXTERNAL_HOSTS)] as ExtFiles
  [Players of streaming services\n(MEDIA_EMBED_HOSTS)] as Embeds
}

database "PostgreSQL" as DB

cloud "Identity providers" {
  [OIDC provider\n(Entra ID / Microsoft 365,\nGoogle Workspace, other)] as OIDC
  [LDAP / Active Directory] as LDAP
}

[SMTP server] as SMTP
[Breached-password range API\n(optional)] as HIBP
[Mock OIDC provider\n(dev port 4010, test port 4011)] as DevOidc
[External LMS\n(SCORM 1.2 / 2004)] as LMS
[Downstream systems\n(access control, HR)] as Down
folder "Content packs\n(YAML + Markdown in Git)" as Packs

Learner --> LA
Staff --> AA
Facilitator --> AA
Analyst --> AA

LA --> Player
AA --> Player : preview
Player --> RT
PR -- RT

Spa ..> LA : delivers bundle
PR --> Api : JSON over HTTPS\n(__Host- session cookie\n+ CSRF header)
LA --> Auth : OIDC redirect

Auth --> Idp
Api --> Accounts : sign-in, factors,\nsessions
Idp --> Accounts
Idp --> OIDC : code flow + PKCE\n(oidcc)
Idp --> LDAP : LDAPS search, then bind
Idp ..> DevOidc : dev and test
Accounts --> Limiter
Accounts --> Vault
Accounts ..> HIBP : k-anonymity range query

Api --> Catalog
Api --> Learning
Api --> Credentials
Api --> Policies
Api --> Insights
Api --> Interop
Api --> Workbench
Api --> Media : media library
PR --> MediaRoute : images, videos,\ncaptions (byte ranges)
MediaRoute --> Media : servable

Learning --> Credentials : requirement events
Policies --> Credentials : refresher events

Repo --> DB
Oban --> DB : job queue

Oban --> Credentials : validity and refresher schedule
Oban --> Interop : SCORM exports
Oban --> Insights : retention purge
Oban --> Media : conversion jobs,\nstale sweep, retention
Media --> Store : content-addressed files
Media --> Ffmpeg : Port.open, argument list,\n-protocol_whitelist file
Ffmpeg --> Store : reads incoming,\nwrites work
Media ..> Clamd : INSTREAM over\nUnix socket
Catalog --> Media : import ingests\nmedia/ files
Workbench --> Media : media entries
Interop --> Media : delivery files for\npack and SCORM export
Player ..> ExtFiles : after play
Player ..> Embeds : after consent
Oban --> SMTP : notifications, invitation, e-mail change\nand recovery links
Oban --> Down : signed webhooks
Down --> Api : integration API\n(machine token)

Packs --> Catalog : import\n(mix task or upload)
Packs --> Workbench : zip upload
Workbench --> Catalog : check and import\n(loader, validator, importer)
Workbench --> Interop : files of a program\nor an import (pack writer)
Workbench --> Audit : draft created\nand deleted
Workbench ..> Packs : zip download
Interop ..> Packs : pack export\n(mix espalier.export)
Interop ..> LMS : SCORM package (zip)

note bottom of Repo
  All contexts persist through the Repo.
end note

note bottom of LMS
  An exported package contains the player bundle
  with Scorm12Runtime or Scorm2004Runtime. Both
  implement the same Runtime interface as
  PlatformRuntime.
end note
@enduml
