# Copy to .env. `make run` and compose.yaml both read .env. Every value here
# is a placeholder; values with a space, ";" or "#" stand in double quotes.

# Phoenix
PHX_HOST=localhost
PORT=4000
PUBLIC_URL=http://localhost:5173
# PHX_SERVER=true is set by bin/server in the image; leave it unset for development.
# The cookie of the Erlang distribution, only for a RELEASE_DISTRIBUTION other
# than none (docs/security/key-management.md). Empty, each command of the
# release receives a random cookie.
RELEASE_COOKIE=

# Host port of the development database (compose.dev.yaml, config/dev.exs,
# config/test.exs). 5433 leaves 5432 to a PostgreSQL installed on the host;
# without a value, both sides use 5432.
DATABASE_PORT=5433

# Database of the db service in compose.yaml (docs/guides/self-hosting.md).
# POSTGRES_PASSWORD is the password of the database user postgres, and
# DATABASE_URL repeats it: ecto://postgres:<password>@db/espalier_prod. Both
# stay empty here; development uses compose.dev.yaml and DATABASE_PORT.
DATABASE_URL=
POSTGRES_PASSWORD=
POOL_SIZE=10
# The CA certificate that signed the certificate of the database server, the
# only trust anchor of the database connection in production
# (config/runtime.exs). compose.yaml sets it for the service app to the CA of
# its service db-certs, which takes precedence over this file; set it for an
# external PostgreSQL (docs/guides/self-hosting.md). DATABASE_URL takes no
# query parameter ssl, because config/runtime.exs sets the TLS options.
DATABASE_CA_CERT_FILE=

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# 32 random bytes each, Base64 (make gen-keys or openssl rand -base64 32). Keep them out of database backups. A key rotation adds CLOAK_KEY_V2 (docs/security/key-management.md).
CLOAK_KEY_V1=
CLOAK_HMAC_SECRET=

# Mail. Without SMTP_HOST, a production instance delivers no mail; development
# sends to Mailpit (compose.dev.yaml). Production connects to SMTP_HOST
# itself, without an MX lookup, and uses STARTTLS with certificate
# verification.
MAIL_FROM="Espalier <noreply@example.org>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Accounts and sessions (README section 6.11, docs/security/authentication.md).
LOCAL_ACCOUNTS=true
# closed | invite | domain
SIGNUP=closed
# Comma-separated domains for SIGNUP=domain.
SIGNUP_DOMAINS=
# Comma-separated addresses that receive the role admin at every boot.
BOOTSTRAP_ADMIN_EMAILS=
# off | hibp (Pwned Passwords range API, decision D10)
PASSWORD_BREACH_CHECK=off
# Comma-separated words of the organization that passwords must not consist of.
PASSWORD_CONTEXT_WORDS=
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=24
SESSION_MAX_CONCURRENT=5
# Admins must hold a passkey (README section 6.11); false logs a warning at boot.
ADMIN_REQUIRE_PASSKEY=true
# Demo sign-in for test sessions only.
AUTH_DEMO=false
# Comma-separated addresses or CIDR ranges of the reverse proxies.
TRUSTED_PROXIES=

# Learning records (README section 10). minimal | standard: standard adds the
# correctness of each practice answer per person, for resume across devices.
TRACKING_DETAIL=minimal
# true stores the org unit of the user in the anonymous item statistics.
INSIGHTS_ORG_UNIT=false

# Anonymous insights (task 0014). Reports suppress every cell with fewer
# responses or people than INSIGHTS_MIN_GROUP_SIZE. FEEDBACK_FREE_TEXT=true
# adds the free-text questions of the feedback station; TEST_NOTES=true
# records the interactions of a usability test in the browser only.
INSIGHTS_MIN_GROUP_SIZE=5
FEEDBACK_FREE_TEXT=false
TEST_NOTES=false
# Retention in days; an empty value deletes nothing. The GDPR workstream
# decides the periods (README section 10).
RETENTION_ITEM_RESPONSES_DAYS=
RETENTION_ANONYMOUS_DAYS=
RETENTION_AUDIT_DAYS=
RETENTION_ATTEMPTS_DAYS=

# Credentials (task 0013). The daily sweep moves a credential to refresh_due
# once valid_until is CREDENTIAL_NOTICE_DAYS days away or closer, and to
# expired once more than CREDENTIAL_GRACE_DAYS days have passed since
# valid_until.
CREDENTIAL_NOTICE_DAYS=30
CREDENTIAL_GRACE_DAYS=30
# true enables the per-person credential list of the registrar role.
REGISTRAR_ENABLED=false
# Webhook receivers: comma-separated entries host or host:port, without
# scheme or path. A webhook URL must use https (http also in dev and test)
# and name a listed host; an entry without a port admits the default port
# of the URL's scheme, and an empty list admits no webhook.
WEBHOOK_ALLOWED_HOSTS=
# Webhook secrets: one variable per webhook, named WEBHOOK_SECRET_<NAME>,
# entered in the webhook's secret_env. The database stores only the name.
WEBHOOK_SECRET_DEMO=
# The largest content pack upload in MB (a positive integer). The archive
# may declare at most five times this size and at most 2,000 entries.
PACK_UPLOAD_MAX_MB=20
# The directory of the SCORM packages of the export (task 0016). Empty
# values write to tmp/exports in development and tmp/test-exports in
# tests; production requires a path, for example /data/exports. The
# directory belongs to one installation and its database: the retention
# deletes packages there that its database does not know.
EXPORT_DIR=

# Media (task 0018, docs/guides/media.md). The root of the media store:
# empty values use tmp/media in development and tmp/test-media in tests;
# production requires a path, and compose.yaml sets /data/media. The
# directory belongs to one installation and its database: the sweep deletes
# stored files there that its database does not name.
MEDIA_DIR=
# The largest raster image and the largest video in MB (positive integers).
# SVG files take at most 1 MiB and WebVTT files 512 KiB. MEDIA_VIDEO_MAX_MB
# stays at most 2047 while MEDIA_CLAMAV_SOCKET is set.
MEDIA_IMAGE_MAX_MB=20
MEDIA_VIDEO_MAX_MB=1024
# The longest video in minutes (a positive integer).
MEDIA_VIDEO_MAX_MINUTES=60
# The height of a converted video (240 to 2160) and the longest edge of a
# converted image (320 to 8192), in pixels.
MEDIA_VIDEO_MAX_HEIGHT=1080
MEDIA_IMAGE_MAX_EDGE=2560
# The quota of the delivery and incoming files of the media store in GB.
MEDIA_STORAGE_MAX_GB=50
# Hosts of external video files and of embedded players: comma-separated
# entries host or host:port, without scheme, path or IPv6 address. Each host
# enters the CSP; an entry without a port admits port 443. MEDIA_EMBED_HOSTS
# must not name the host of PUBLIC_URL. Empty values admit no host;
# development admits embed.espalier.test in MEDIA_EMBED_HOSTS.
MEDIA_EXTERNAL_HOSTS=
MEDIA_EMBED_HOSTS=
# click | auto: click loads an embedded player after the learner agrees in a
# notice that names its host; auto loads it with the page (README section 10).
MEDIA_EMBED_CONSENT=click
# The absolute path of the clamd Unix socket, at most 107 bytes. Set, every
# uploaded and imported media file passes a malware scan; unset, no scan runs
# (docs/guides/examples/compose.clamav.yaml sets /run/clamav/clamd.sock).
MEDIA_CLAMAV_SOCKET=
# Threads per ffmpeg and ffprobe process (1 to 16).
MEDIA_FFMPEG_THREADS=2

# External identity providers, in the order of the sign-in page (tasks 0006, 0007).
# docs/guides/identity-providers.md describes every variable. Client secrets,
# certificates and keys come from the runtime environment only.
AUTH_PROVIDERS=

# Microsoft Entra ID (single tenant). Outside development, the client
# authenticates with a certificate (private_key_jwt); a client secret is
# refused. Empty values take the defaults named in the comments.
AUTH_ENTRA_TYPE=entra
AUTH_ENTRA_LABEL="Microsoft 365"
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_CLIENT_ID=
# Default issuer: https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_ENTRA_ISSUER=
AUTH_ENTRA_CLIENT_CERT_FILE=
AUTH_ENTRA_CLIENT_KEY_FILE=
# x5t (default, the format Entra ID accepts) | x5t_s256 | sha1_hex
AUTH_ENTRA_CLIENT_KID_FORMAT=
AUTH_ENTRA_ROLE_MAP="admin=Espalier.Admin;author=Espalier.Author"
# local (default) | idp_trusted
AUTH_ENTRA_MFA=local
# amr values that count as multi-factor in idp_trusted mode (default: mfa)
AUTH_ENTRA_MFA_AMR=
# true (default) | false
AUTH_ENTRA_PROVISION=true
# Hosts of the provider's endpoints (default: the issuer host)
AUTH_ENTRA_ALLOWED_HOSTS=

# Google Workspace.
AUTH_GOOGLE_TYPE=google
AUTH_GOOGLE_LABEL="Google Workspace"
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_HOSTED_DOMAIN=
AUTH_GOOGLE_MFA=local
AUTH_GOOGLE_MFA_AMR=
AUTH_GOOGLE_PROVISION=true
# Default: accounts.google.com,oauth2.googleapis.com,www.googleapis.com
AUTH_GOOGLE_ALLOWED_HOSTS=

# Any other OIDC provider, here with the key "corp".
AUTH_CORP_TYPE=oidc
AUTH_CORP_LABEL="Company sign-in"
AUTH_CORP_ISSUER=
AUTH_CORP_CLIENT_ID=
AUTH_CORP_CLIENT_SECRET=
AUTH_CORP_CLIENT_CERT_FILE=
AUTH_CORP_CLIENT_KEY_FILE=
# client_secret_basic (default with a secret) | client_secret_post |
# private_key_jwt (default with a certificate)
AUTH_CORP_CLIENT_AUTH=
AUTH_CORP_CLIENT_KID_FORMAT=
# Default: roles
AUTH_CORP_ROLE_CLAIM=
AUTH_CORP_ROLE_MAP=
AUTH_CORP_MFA=local
AUTH_CORP_MFA_AMR=
# false (default) | true
AUTH_CORP_PROVISION=false
AUTH_CORP_ALLOWED_HOSTS=

# Development against the mock OIDC provider of `make run` or `make dev-oidc`
# (port 4010). Uncomment the block after the blocks above. Each client secret
# is the fixture secret of the mock in config/dev.exs, which works only
# against the mock.
# AUTH_PROVIDERS=entra,google,oidc
# AUTH_ENTRA_TYPE=entra
# AUTH_ENTRA_LABEL="Entra ID (mock)"
# AUTH_ENTRA_TENANT_ID=3f0c2a9e-7b1d-4e5a-8c6f-2d9b0e4a1c7d
# AUTH_ENTRA_ISSUER=http://localhost:4010/entra/3f0c2a9e-7b1d-4e5a-8c6f-2d9b0e4a1c7d/v2.0
# AUTH_ENTRA_CLIENT_ID=espalier-dev
# AUTH_ENTRA_CLIENT_SECRET=
# AUTH_ENTRA_ROLE_MAP="author=Espalier.Author;admin=Espalier.Admin"
# AUTH_ENTRA_MFA=local
# AUTH_GOOGLE_TYPE=google
# AUTH_GOOGLE_LABEL="Google (mock)"
# AUTH_GOOGLE_ISSUER=http://localhost:4010/google
# AUTH_GOOGLE_CLIENT_ID=espalier-dev
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_HOSTED_DOMAIN=example.org
# AUTH_OIDC_TYPE=oidc
# AUTH_OIDC_LABEL="Generic OIDC (mock)"
# AUTH_OIDC_ISSUER=http://localhost:4010/oidc
# AUTH_OIDC_CLIENT_ID=espalier-dev
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_ROLE_MAP="admin=espalier-admins"

# Active Directory or another LDAP server (task 0007). The service account
# can only read user objects below the base DN; its password is the only
# stored directory credential. AUTH_LDAP_FAILURE_LIMIT stays below the
# directory's lockout threshold. docs/guides/identity-providers.md describes
# every variable.
AUTH_LDAP_TYPE=ldap
AUTH_LDAP_LABEL="Company account"
AUTH_LDAP_HOST=
# Default: 636 for ldaps, 389 otherwise
AUTH_LDAP_PORT=
# ldaps (default) | starttls | none (none only in dev and test)
AUTH_LDAP_TLS=ldaps
# PEM file with the CA chain of the directory's certificate; the only trust anchors.
AUTH_LDAP_CA_CERT_FILE=
# true adds wildcard matching of the certificate name
AUTH_LDAP_TLS_WILDCARD=false
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_BASE_DN=
# ad (default) | generic
AUTH_LDAP_DIRECTORY=ad
# Default: sAMAccountName,userPrincipalName for ad, uid for generic
AUTH_LDAP_USER_ATTR=
AUTH_LDAP_ORG_UNIT_ATTR=
AUTH_LDAP_ROLE_MAP="admin=CN=espalier-admins,OU=Groups,DC=example,DC=org"
AUTH_LDAP_TIMEOUT_MS=5000
# Required: 1 to 49, below the directory's lockout threshold
AUTH_LDAP_FAILURE_LIMIT=
# At least the directory's lockout counter reset time
AUTH_LDAP_LOCK_MINUTES=30
AUTH_LDAP_MFA=local

# Development against the lldap container of compose.dev.yaml. `make
# ldap-ca` writes the test CA to dev/ldap-ca/, `make ldap-secrets` writes the
# lldap container secrets to dev/lldap/secrets.env (both run with `make
# services-up`), and `make services-seed` loads the invented users. Uncomment
# the block after the blocks above. A run with the OIDC block and this block,
# for example the @oidc and @ldap end-to-end specs of task 0011 together, uses
# the single line AUTH_PROVIDERS=entra,google,oidc,ldap, because .env keeps
# only the last AUTH_PROVIDERS line.
# AUTH_PROVIDERS=ldap
# AUTH_LDAP_TYPE=ldap
# AUTH_LDAP_LABEL="Directory account (dev)"
# AUTH_LDAP_HOST=localhost
# AUTH_LDAP_PORT=6360
# AUTH_LDAP_TLS=ldaps
# AUTH_LDAP_CA_CERT_FILE=dev/ldap-ca/ca.pem
# AUTH_LDAP_DIRECTORY=generic
# AUTH_LDAP_BIND_DN=uid=espalier-svc,ou=people,dc=example,dc=org
# The password of espalier-svc in dev/lldap/bootstrap/user-configs/espalier-svc.json.
# AUTH_LDAP_BIND_PASSWORD=
# AUTH_LDAP_BASE_DN=dc=example,dc=org
# AUTH_LDAP_USER_ATTR=uid
# AUTH_LDAP_ROLE_MAP="author=cn=espalier-authors,ou=groups,dc=example,dc=org;admin=cn=espalier-admins,ou=groups,dc=example,dc=org"
# AUTH_LDAP_FAILURE_LIMIT=5
# AUTH_LDAP_LOCK_MINUTES=30
