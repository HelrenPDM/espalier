# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
espalier-*.tar

# Project-local Mix and Hex homes from shell.nix.
.nix-mix/
.nix-hex/

# Build output of the frontend and the SCORM player.
/priv/static/spa/
/priv/scorm_player/

# The SCORM schema files, fetched by mix espalier.scorm_xsd (priv/scorm/xsd/SOURCE.md).
/priv/scorm/xsd/12/
/priv/scorm/xsd/2004/
/priv/scorm/xsd/*.part/
/frontend/node_modules/

# Rendered diagrams (make docs).
/docs/architecture/out/

# Local environment files; only the example is tracked.
.env
.env.*
!.env.example
!.env.demo.example

# Development LDAP test CA and lldap secrets (make ldap-ca, make ldap-secrets).
dev/ldap-ca/*.key
dev/ldap-ca/*.pem
dev/ldap-ca/*.srl
dev/lldap/secrets.env
