# The demo profile of decision D5 (docs/guides/demo-instance.md): no personal
# data beyond the demo persons, no external identity provider, data-sparing
# tracking. `make demo-env` copies this file to .env.demo and fills every
# empty secret line from /dev/urandom; `make demo-up` starts the instance.

# The dedicated host name of the demo instance; PUBLIC_URL is its https
# origin, without path.
PHX_HOST=demo.example.org
PUBLIC_URL=https://demo.example.org

# Demo sign-in is the only sign-in pathway: every page shows the demo banner.
AUTH_DEMO=true
AUTH_PROVIDERS=
LOCAL_ACCOUNTS=false

# Per person, only enrollment, path, completion, attempts, acknowledgements,
# attendance and credentials; no per-person credential list.
TRACKING_DETAIL=minimal
REGISTRAR_ENABLED=false

# Usability tests: records the interactions of a test session in the
# browser only.
# TEST_NOTES=true

# Secrets, filled by make demo-env.
SECRET_KEY_BASE=
CLOAK_KEY_V1=
CLOAK_HMAC_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=
